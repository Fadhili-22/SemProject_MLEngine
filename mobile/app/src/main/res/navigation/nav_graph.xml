<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3 (Lecture 6): the Navigation Graph.
     Each <fragment> is a screen (a "destination").
     Each <action> is a path from one screen to another.
     android:label is the title shown in the toolbar on that screen.
     Open this file in Android Studio and click "Design" to see the graph as a diagram. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.mindcheck.ui.WelcomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_welcome_to_checkin"
            app:destination="@id/checkInFragment" />
        <action
            android:id="@+id/action_welcome_to_help"
            app:destination="@id/helpFragment" />
    </fragment>

    <fragment
        android:id="@+id/checkInFragment"
        android:name="com.example.mindcheck.ui.CheckInFragment"
        android:label="@string/title_checkin">
        <!-- popUpTo welcome: pressing Back on the Result screen goes to Welcome,
             not back into the questions -->
        <action
            android:id="@+id/action_checkin_to_result"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/welcomeFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.mindcheck.ui.ResultFragment"
        android:label="@string/title_result">
        <action
            android:id="@+id/action_result_to_help"
            app:destination="@id/helpFragment" />
        <!-- Start again: clear everything and show a fresh Welcome screen -->
        <action
            android:id="@+id/action_result_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/helpFragment"
        android:name="com.example.mindcheck.ui.HelpFragment"
        android:label="@string/title_help" />

</navigation>
