<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3: placeholder Check-in screen. Step 5 replaces this with the real questions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.CheckInFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/placeholder_checkin"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <!-- Temporary button so we can test moving to the Result screen -->
    <Button
        android:id="@+id/finish_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/see_result" />

</LinearLayout>
